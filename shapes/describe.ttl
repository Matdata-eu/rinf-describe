# RINF Describe vocabulary (rd:): the widgets and terms the class shapes use on top
# of SHACL and DASH. Documented in docs/shapes.md.
#
# Each widget is a dash:SingleViewer or dash:MultiViewer, so a generic DASH tool
# reading these shapes still knows what kind of viewer it is and can fall back
# to a plain one.
PREFIX rd:   <https://rinf-describe.matdata.eu/ns#>
PREFIX dash: <http://datashapes.org/dash#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>

<https://rinf-describe.matdata.eu/ns>
    a owl:Ontology ;
    rdfs:label "RINF Describe vocabulary" ;
    rdfs:comment "Widgets and summaries for describe pages laid out by SHACL DASH shapes." .

rd:RouteDiagramViewer a dash:SingleViewer ;
    rdfs:label "Route diagram" ;
    rdfs:comment "Start and end point on a line, with the length and the kilometre positions. Paths: rd:start, rd:end, rd:length, optionally rd:startKm, rd:startOffset, rd:endKm, rd:endOffset." .

rd:MapViewer a dash:MultiViewer ;
    rdfs:label "Map" ;
    rdfs:comment "WKT geometries of sh:path on OpenStreetMap with the OpenRailwayMap overlay. rd:context: geometries drawn as context (the section of line of a track, the end points of a section)." .

rd:AggregateViewer a dash:MultiViewer ;
    rdfs:label "Summary over linked resources" ;
    rdfs:comment "Values of sh:path on each resource reached by rd:over, summed up as rd:aggregate: range, distinct-count or count." .

rd:LrsLocationViewer a dash:SingleViewer ;
    rdfs:label "Railway location" ;
    rdfs:comment "The value with its kilometre position, written km 53+240. Paths: rd:km (kilometric post), rd:offset (metres from it)." .

rd:StepChartViewer a dash:SingleViewer ;
    rdfs:label "Step chart" ;
    rdfs:comment "A profile written as value(length) pairs, e.g. a gradient profile, as a kilometre-ordered step chart: positive values green, negative red." .

rd:SymbolViewer a dash:MultiViewer ;
    rdfs:label "Symbol" ;
    rdfs:comment "An illustrative, non-dimensioned symbol next to each value's label. rd:symbol: loading-gauge, track-gauge or country." .

rd:ValidityViewer a dash:SingleViewer ;
    rdfs:label "Validity" ;
    rdfs:comment "Validity period (an era:TemporalFeature, a time:TemporalDuration) as a bar on a time axis with today marked. Paths: rd:begin, rd:end (xsd:date)." .

rd:ParameterIndexViewer a dash:MultiViewer ;
    rdfs:label "RINF parameters" ;
    rdfs:comment "Every parameter of the resource with a RINF index in the ERA ontology, grouped by RINF index chapter, with its unit and definition. Needs no sh:path. Optional rd:indexRoot." .

rd:DocumentViewer a dash:MultiViewer ;
    rdfs:label "Document" ;
    rdfs:comment "era:Document resources of sh:path as cards with their file type and a link to open them. sh:node shape:document-card gives the address and name." .

rd:FacilitiesViewer a dash:MultiViewer ;
    rdfs:label "Facilities" ;
    rdfs:comment "Boolean parameters as tiles: yes, no, not applicable, not yet available. rd:facility: one per property." .

rd:ScaleBarViewer a dash:SingleViewer ;
    rdfs:label "Scale bar" ;
    rdfs:comment "A length as a bar against rd:marks (\"400 Passenger train; 740 Freight train\"), or the range rd:min to rd:max on a scale (rd:scale \"4 7\")." .

rd:ConnectionsViewer a dash:MultiViewer ;
    rdfs:label "Connections" ;
    rdfs:comment "The sections of line that start or end at an operational point as spokes, each to the operational point at its other end. Columns: start, end, line, length, wkt." .

rd:TrackLayoutViewer a dash:MultiViewer ;
    rdfs:label "Track layout" ;
    rdfs:comment "Schematic of an operational point: its tracks, platform edges on them, and sidings. rd:platforms and rd:sidings name the table rows to read." .

rd:PlatformViewer a dash:SingleViewer ;
    rdfs:label "Platform" ;
    rdfs:comment "Side view of a platform edge against the TSI heights 550 and 760 mm. Paths: rd:height, rd:length, rd:curved." .

rd:LineProfileViewer a dash:MultiViewer ;
    rdfs:label "Line profile" ;
    rdfs:comment "A national line along km: a lane per column of its sections (rd:table, rd:lanes), numbers as steps, categories as bands, operational points as ticks." .

rd:LineStopsViewer a dash:MultiViewer ;
    rdfs:label "Operational points along a line" ;
    rdfs:comment "The operational points of a line in km order, from the ends of the sections in rd:table." .

rd:AlongLineViewer a dash:MultiViewer ;
    rdfs:label "Along the line" ;
    rdfs:comment "A section of line as a strip with the assets of the rows in rd:markers at their km; rd:table names the route row with the section's km." .

rd:CrossSectionViewer a dash:SingleViewer ;
    rdfs:label "Cross-section" ;
    rdfs:comment "A track end-on, not to scale. Paths: rd:gauge, rd:loadingGauge, rd:wireMin, rd:wireMax, rd:inclination." .

rd:KeyFiguresViewer a dash:MultiViewer ;
    rdfs:label "Key figures" ;
    rdfs:comment "Stat tiles for the summary rows named in rd:figures: numbers, and shares as a bar." .

rd:ChangesViewer a dash:MultiViewer ;
    rdfs:label "Changes over time" ;
    rdfs:comment "Parameters with an applicability period on a time axis. Columns: parameter, value, begin, end." .

rd:DataStatusViewer a dash:MultiViewer ;
    rdfs:label "Data status" ;
    rdfs:comment "Parameters marked era:notApplicable or era:notYetAvailable. Shown on every class page; needs no property shape." .

rd:GraphViewer a dash:MultiViewer ;
    rdfs:label "Graph" ;
    rdfs:comment "Interactive neighbourhood graph from the indexed triples; nodes open their own page. Shown on every page; needs no property shape." .

rd:tab a owl:DatatypeProperty ;
    rdfs:label "tab" ;
    rdfs:comment "Tab of a sh:PropertyGroup, shown as its title; overview by default." .
rd:over a owl:ObjectProperty ;
    rdfs:label "over" ;
    rdfs:comment "SHACL path to linked resources; sh:path is evaluated on each of them." .
rd:aggregate a owl:DatatypeProperty ;
    rdfs:label "aggregate" ;
    rdfs:comment "range, distinct-count or count: how the values reached through rd:over are summed up." .
rd:unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    rdfs:comment "Display unit written after the value." .
rd:badge a owl:DatatypeProperty ;
    rdfs:label "badge" ;
    rdfs:comment "Template of the header badge of a dash:KeyInfoRole property: {value}, {min}, {max}, {count}, {withValue}, {children}, {unit}." .
rd:symbol a owl:DatatypeProperty ;
    rdfs:label "symbol" ;
    rdfs:comment "Symbol set of rd:SymbolViewer." .
rd:indexRoot a owl:DatatypeProperty ;
    rdfs:label "index root" ;
    rdfs:comment "RINF index root(s) of rd:ParameterIndexViewer, e.g. 1.2.1 for a track of an operational point." .
rd:facility a owl:ObjectProperty ;
    rdfs:label "facility" ;
    rdfs:comment "A boolean property shown as a tile by rd:FacilitiesViewer; repeat for each." .
rd:marks a owl:DatatypeProperty ;
    rdfs:label "marks" ;
    rdfs:comment "Reference marks of rd:ScaleBarViewer: value label pairs separated by semicolons." .
rd:class a owl:ObjectProperty ;
    rdfs:label "class" ;
    rdfs:comment "Only the linked resources of this class." .
rd:limit a owl:DatatypeProperty ;
    rdfs:label "limit" ;
    rdfs:comment "At most this many linked resources of a table at a time; the rest on demand." .
rd:scope a owl:DatatypeProperty ;
    rdfs:label "scope" ;
    rdfs:comment "\"all\": evaluate the row over every graph, not only the resource's own." .
rd:layers a owl:DatatypeProperty ;
    rdfs:label "layers" ;
    rdfs:comment "Keys of table rows whose wkt column rd:MapViewer draws as layers." .
rd:hidden a owl:DatatypeProperty ;
    rdfs:label "hidden" ;
    rdfs:comment "\"true\": a column that is read but not shown." .
rd:figures a owl:DatatypeProperty ;
    rdfs:label "figures" ;
    rdfs:comment "Keys of the summary rows rd:KeyFiguresViewer shows." .
rd:table a owl:DatatypeProperty ;
    rdfs:label "table" ;
    rdfs:comment "Key of another row of the page whose values the widget draws (the sections of a line profile); the row needs no path." .
rd:lanes a owl:DatatypeProperty ;
    rdfs:label "lanes" ;
    rdfs:comment "Columns of the rd:table row drawn as lanes by rd:LineProfileViewer." .
rd:markers a owl:DatatypeProperty ;
    rdfs:label "markers" ;
    rdfs:comment "Keys of the rows whose resources rd:AlongLineViewer places along the line." .
rd:sortBy a owl:DatatypeProperty ;
    rdfs:label "sort by" ;
    rdfs:comment "Column a table is sorted by, as numbers." .
rd:cacheSeconds a owl:DatatypeProperty ;
    rdfs:label "cache seconds" ;
    rdfs:comment "On a node shape: how long its pages are kept (86400 for national lines)." .
rd:key a owl:DatatypeProperty ;
    rdfs:label "key" ;
    rdfs:comment "Stable key of a property row; by default made from sh:name or the path." .

rd:ConceptTreeViewer a dash:MultiViewer ;
    rdfs:label "Concept tree" ;
    rdfs:comment "SKOS concepts (sh:path, sh:node with columns broader and notation) as a tree along skos:broader. On a concept page the concept is marked and its branch open." .

rd:TopologyViewer a dash:MultiViewer ;
    rdfs:label "Topology" ;
    rdfs:comment "Net relations (sh:path, sh:node with columns a, b, navigability, origin-a, origin-b) as a graph of linear elements, arrows the way a train can pass. rd:elements: the row with the elements (wkt, length) that places them as on the map." .

rd:PositionedViewer a dash:MultiViewer ;
    rdfs:label "Positioned on an element" ;
    rdfs:comment "Objects positioned on a linear element (sh:path, sh:node with columns type, on, offset) as ticks along it at their offset from its origin, and by type." .

rd:LinePositionViewer a dash:SingleViewer ;
    rdfs:label "Position on the line" ;
    rdfs:comment "A kilometric post (the page's km row) on its line, with the line's operational points (rd:table: sections with from, to, start-km... end-offset) and posts (rd:posts: rows with a km column)." .

rd:elements a owl:DatatypeProperty ;
    rdfs:label "elements" ;
    rdfs:comment "Key of the row with the linear elements rd:TopologyViewer draws as nodes." .
rd:posts a owl:DatatypeProperty ;
    rdfs:label "posts" ;
    rdfs:comment "Key of the row with the kilometric posts rd:LinePositionViewer draws as ticks." .
