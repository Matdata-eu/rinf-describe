# Port of the web UI.
DESCRIBE_PORT=8090
# Environments in menu order (key=label); the first is the default.
# DESCRIBE_SPARQL_PROD / DESCRIBE_SPARQL_UAT override ERA's SPARQL endpoints, and
# DESCRIBE_DATASETS_PROD / DESCRIBE_DATASETS_UAT its dataset explorer APIs.
DESCRIBE_ENVS=prod=PROD,uat=UAT
# Pages: shape rows per SPARQL query, and queries in flight per page.
DESCRIBE_LIVE_BATCH=12
DESCRIBE_LIVE_WORKERS=8
# What one instance may ask of ERA's shared endpoint: SPARQL queries in flight at once,
# and answers kept in memory (pages for 10 minutes, examples and sitemaps for a day).
DESCRIBE_MAX_QUERIES=16
DESCRIBE_CACHE_ENTRIES=2000
# Requests per second each client may make to /api/ (bursts of 4x allowed); "off": no limit.
DESCRIBE_RATE_LIMIT=10
# Reverse proxies in front of this instance (addresses or CIDR ranges, comma separated),
# whose X-Forwarded-For then names the client for the rate limit. Empty: none.
DESCRIBE_TRUSTED_PROXIES=
# RINF Atlas instance the search box asks for names and the "Open in RINF Atlas" button
# points to. Empty: the search box takes IRIs only and the button is hidden.
DESCRIBE_ATLAS_URL=https://rinf-atlas.matdata.eu
# Public address (https://rinf-describe.example.org). Set: canonical links, sitemaps, and
# search engines may index the instance. Empty: they are asked not to (docs/seo.md).
DESCRIBE_PUBLIC_URL=
# "off" keeps an instance with a public address out of search engines (test, UAT).
DESCRIBE_INDEXING=
# Published image tag to run (docker compose pull): latest, X.Y.Z or X.Y.
DESCRIBE_VERSION=latest
