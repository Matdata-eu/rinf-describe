# Port of the web UI.
DESCRIBE_PORT=8090
# RINF Atlas's Docker network and database (its docker-compose.yml and .env).
ATLAS_NETWORK=rinf-atlas_default
ATLAS_DB_HOST=db
ATLAS_DB_NAME=atlas
ATLAS_DB_USER=atlas
POSTGRES_PASSWORD=atlas
# Password of the read-only role describe_ro the API connects with (created by db-role).
DESCRIBE_DB_PASSWORD=describe
# Environments in menu order (key=label); the first is the default.
DESCRIBE_ENVS=prod=PROD,uat=UAT
# 1: resources the index does not hold are read live from ERA's SPARQL endpoint, with
# their class pages built from the shapes. DESCRIBE_SPARQL_PROD / DESCRIBE_SPARQL_UAT
# override the endpoints.
DESCRIBE_LIVE=1
# Live class pages: shape rows per SPARQL query, and queries in flight per page.
DESCRIBE_LIVE_BATCH=12
DESCRIBE_LIVE_WORKERS=8
# RINF Atlas instance the "Open in RINF Atlas" button points to (empty hides it).
DESCRIBE_ATLAS_URL=https://rinf-atlas.matdata.eu
# Public address (https://rinf-describe.example.org). Set: canonical links, sitemaps, and
# search engines may index the instance. Empty: they are asked not to (docs/seo.md).
DESCRIBE_PUBLIC_URL=
# "off" keeps an instance with a public address out of search engines (test, UAT).
DESCRIBE_INDEXING=
# Published image tag to run (docker compose pull): latest, X.Y.Z or X.Y.
DESCRIBE_VERSION=latest
